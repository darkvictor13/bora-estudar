{
  "name": "bora-estudar",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @bora/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "bash supabase/tests/run.sh",
    "db:types": "npm run generate --workspace @bora/database",
    "test:e2e": "node scripts/roundtrip.mjs",
    "ext:build": "npm run build --workspace @bora/extension",
    "ext:watch": "npm run watch --workspace @bora/extension"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "supabase": "^2.115.0",
    "typescript": "^5.7.2"
  }
}

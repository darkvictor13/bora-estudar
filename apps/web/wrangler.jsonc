{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fronteira-concursos",
  "compatibility_date": "2026-08-23",
  // O portão dos materiais: só `/materials/*` executa código (`worker/index.ts`).
  // O resto do site continua sendo servido direto pela camada de assets.
  // `SUPABASE_URL` e `SUPABASE_PUBLISHABLE_KEY` NÃO ficam aqui: `vars` não é
  // herdado pelos ambientes, e os valores são os mesmos `vars` do GitHub que o
  // build usa — entram por `--var` no deploy. Sem eles o portão FALHA FECHADO.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/materials/*"]
  },
  "env": {
    // Vazio de propósito: pela regra do sufixo o Worker publicado é
    // `fronteira-concursos-staging`, que é o nome que já está no ar.
    "staging": {},
    // Produção precisa de `name` explícito, senão o sufixo a transformaria em
    // `fronteira-concursos-producao`. Deploy SEMPRE com `--env`: um `wrangler deploy`
    // sem a flag publica o Worker `fronteira-concursos` do nível superior, que não é
    // ambiente nenhum.
    "producao": { "name": "fronteira-concursos" }
  }
}

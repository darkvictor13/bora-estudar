# Copie para .env.local e preencha com a saída de `supabase status`.
# O stack local sempre gera as mesmas chaves, então estes valores servem
# para qualquer máquina do time.
#
# O prefixo VITE_ não é decoração: o Vite só injeta no bundle as variáveis que
# começam com ele. Uma chave sem o prefixo chega como undefined no navegador.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

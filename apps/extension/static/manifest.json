{
  "manifest_version": 3,
  "name": "Bora Estudar — Bateria Inteligente",
  "version": "0.1.0",
  "description": "Conduz a bateria de questões no TEC Concursos e devolve o resultado ao Bora Estudar.",

  "browser_specific_settings": {
    "gecko": {
      "id": "bora-estudar@boraestudarconcursos.com.br",
      "strict_min_version": "128.0"
    }
  },

  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.tecconcursos.com.br/*"],

  "content_scripts": [
    {
      "matches": ["https://www.tecconcursos.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Bora Estudar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
